// NOT VALIDATED in Power BI Desktop. Model: fact_transaction_line (many) -> dim_date, dim_customer,
// dim_product, dim_country (one). Mark dim_date[full_date] as the date table. Relationship on date_key.
// Fact also needs a calculated/Power Query column: SaleFlag etc. is avoided - use line_type filters below.

Gross Sales = CALCULATE(SUM(fact_transaction_line[line_value]), fact_transaction_line[line_type] = "sale")
Returns = CALCULATE(-SUM(fact_transaction_line[line_value]), fact_transaction_line[line_type] = "cancellation")
Net Sales = [Gross Sales] - [Returns]
Invoice Count = CALCULATE(DISTINCTCOUNT(fact_transaction_line[invoice_no]), fact_transaction_line[line_type] = "sale")
Customer Count = CALCULATE(DISTINCTCOUNT(fact_transaction_line[customer_key]), fact_transaction_line[line_type] = "sale")
Average Invoice Value = DIVIDE([Gross Sales], [Invoice Count])

Repeat Customers =
VAR t = ADDCOLUMNS(
          VALUES(dim_customer[customer_key]),
          "@inv", CALCULATE(DISTINCTCOUNT(fact_transaction_line[invoice_no]), fact_transaction_line[line_type] = "sale"))
RETURN COUNTROWS(FILTER(t, [@inv] >= 2))
Repeat Purchase Rate = DIVIDE([Repeat Customers], [Customer Count])

Net Sales PM = CALCULATE([Net Sales], DATEADD(dim_date[full_date], -1, MONTH))
MoM Growth % = DIVIDE([Net Sales] - [Net Sales PM], [Net Sales PM])
Net Sales PY = CALCULATE([Net Sales], SAMEPERIODLASTYEAR(dim_date[full_date]))
YoY Growth % = DIVIDE([Net Sales] - [Net Sales PY], [Net Sales PY])

// Cohort retention - requires dim_customer[cohort_month] (first sale month) from Power Query / SQL view.
// Denominator = customers in the cohort (month 0). cohort_age column on a bridge table of customer-month activity.
Cohort Size = CALCULATE(DISTINCTCOUNT(customer_activity[customer_key]), customer_activity[cohort_age] = 0)
Active in Age = DISTINCTCOUNT(customer_activity[customer_key])
Retention % = DIVIDE([Active in Age], [Cohort Size])

// RFM: import exports/customer_rfm.csv as table customer_rfm (relationship customer_id).
RFM Segment Count = COUNTROWS(customer_rfm)
Revenue by Segment = SUM(customer_rfm[monetary])
